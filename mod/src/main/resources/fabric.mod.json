{
  "schemaVersion": 1,
  "id": "tailcraft",
  "version": "${version}",
  "name": "Tailcraft",
  "description": "Play Minecraft with friends without port forwarding. Servers get a permanent Tailcat address; players paste it into the normal server address box.",
  "authors": ["RefinedChicken"],
  "contributors": ["Based on Tailcat for Minecraft by Tailscale"],
  "contact": { "sources": "https://github.com/RefinedChicken/tailcraft", "issues": "https://github.com/RefinedChicken/tailcraft/issues" },
  "license": "BSD-3-Clause",
  "environment": "*",
  "entrypoints": {
    "client": ["io.github.refinedchicken.tailcraft.client.TailcraftClient"],
    "server": ["io.github.refinedchicken.tailcraft.server.TailcraftServer"]
  },
  "mixins": ["tailcraft.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "${minecraft_range}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
